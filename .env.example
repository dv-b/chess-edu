# Copy to .env.local (or export in your shell) for local dev.

# ---- Docker compose host ports (override if these collide on your machine) ----
# Defaults are shifted off the standard ports so they won't clash with an
# already-installed Postgres (5432), Redis (6379), or MinIO (9000) on your host.
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6380
MINIO_API_HOST_PORT=9010
MINIO_CONSOLE_HOST_PORT=9011
MAIL_HOST_PORT=2525
MAIL_UI_HOST_PORT=8125

# ---- Backend (Spring Boot) — point these at the docker-compose host ports ----
SPRING_PROFILES_ACTIVE=local
DB_URL=jdbc:postgresql://localhost:5433/chessedu
DB_USER=chessedu
DB_PASSWORD=chessedu
REDIS_HOST=localhost
REDIS_PORT=6380
MAIL_HOST=localhost
MAIL_PORT=2525
JWT_SECRET=dev-only-change-me-dev-only-change-me-dev-only

# ---- Telegram bot (signup / sign-in for non-student roles) ----
# Master switch — leave false unless you have a bot token and want the worker
# to long-poll Telegram. The bot worker bean isn't even created when false.
CHESSEDU_TELEGRAM_ENABLED=false
# From @BotFather. Keep this secret — never commit a real token.
CHESSEDU_TELEGRAM_BOT_TOKEN=
# The bot's @username (without the @), used to build t.me/<username>?start=… deeplinks.
CHESSEDU_TELEGRAM_BOT_USERNAME=
# Override only for testing against a mock Telegram server.
CHESSEDU_TELEGRAM_API_BASE_URL=https://api.telegram.org
# Long-poll hold (seconds) and one-time-token TTL (ISO-8601 duration).
CHESSEDU_TELEGRAM_POLL_TIMEOUT=50
CHESSEDU_TELEGRAM_OTT_TTL=PT10M

# ---- Frontend (Next.js) ----
NEXT_PUBLIC_APP_NAME=Kingside
API_BASE_URL=http://localhost:8080
